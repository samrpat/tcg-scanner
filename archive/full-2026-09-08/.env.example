# Copy to .env and adjust. Never commit .env.

# ---- Database ----
POSTGRES_USER=tcg
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=tcg
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API. Empty = same-origin only.
CORS_ORIGINS=

# ---- Web ----
# Host port the UI is served on.
WEB_PORT=8080
# HTTPS port. Browsers only allow camera access over HTTPS or on localhost, so a phone on the
# LAN needs this. Run `make cert` once to generate a certificate.
WEB_TLS_PORT=8443

# Spacing around the card in listing photographs, in millimetres. A buyer judges edge wear and
# corner sharpness against the background, so a crop crushed to the card's edge hides exactly
# what they need. Applies uniformly to every card.
LISTING_MARGIN_MM=5.0
# Fixed render scale for listing images, so every one comes out the same pixel size whatever
# distance the card was shot from. Keep at or below your usual capture scale: this only ever
# downsamples, and upscaling a soft capture makes it look worse.
LISTING_PX_PER_MM=30.0

# ---- Imaging ----
# auto: rectify at roughly the scale the camera resolved, clamped to the range below.
# fixed: pin every card to PROCESSED_PX_PER_MM.
PROCESSED_SCALE_MODE=auto
PROCESSED_PX_PER_MM=40
PROCESSED_PX_PER_MM_MIN=10
# 80 px/mm is ~35 megapixels per side. Lower this to trade fidelity for disk:
# 2,000 cards at 12MP-phone quality is roughly 30GB, at 1080p roughly 4GB.
PROCESSED_PX_PER_MM_MAX=80
PROCESSED_JPEG_QUALITY=97

# ---- Storage ----
# local | s3   (s3 lands in Phase 10)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/images

# ---- Worker ----
# Capability tags this worker accepts. Pi-only: all of them.
# Desktop worker: recognize,condition
WORKER_TAGS=ingest,recognize,condition
WORKER_CONCURRENCY=2

# ---- TCGdex ----
# Public API. Point at http://tcgdex:3000 when running --profile tcgdex.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_LANGUAGE=en
# Politeness delay between requests, seconds. TCGdex publishes no hard limit.
TCGDEX_REQUEST_DELAY=0.05

# ---- Pricing ----
# Currency shown in the UI. Cardmarket EUR is still stored alongside.
DISPLAY_CURRENCY=USD
PRICING_PRIMARY_SOURCE=tcgdex_tcgplayer

# ---- Marketplace credentials ----
# Left blank in Phase 1. Never commit real values; these are read from the
# environment only and are referenced from the database by name, not by value.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=

# ── eBay sold prices (optional) ──────────────────────────────────────────────
# Apify runs the eBay scraper that reads completed sold listings. Costs about
# $1.50 per 1,000 results and is never called automatically — only for cards you
# select in Inventory. Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=

# ── Where eBay fetches listing photographs from ──────────────────────────────
# eBay's servers fetch each picture URL once at import. If that fetch fails the
# draft is created with NO photographs and no error you will see, so this wants
# to be something durable.
#
# Anything S3-compatible works. Cloudflare R2's free tier is the easy one:
#   1. dash.cloudflare.com -> R2 -> Create bucket (e.g. "cards")
#   2. Settings -> Public access -> Allow, which gives you a pub-xxxx.r2.dev URL
#   3. Manage API tokens -> Create, with Object Read & Write
#
S3_ENDPOINT=          # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE=       # https://pub-xxxxxxxx.r2.dev

# ── Mode ─────────────────────────────────────────────────────────────────────
# true  = scanner: crop, render, export photographs. No identification or pricing.
# false = the full path, through to an eBay upload file.
SCANNER_MODE=true
